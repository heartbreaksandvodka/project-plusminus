# EA Service Environment Configuration
# Copy this to .env and update values as needed

# Service Configuration
EA_SERVICE_HOST=127.0.0.1
EA_SERVICE_PORT=8001
EA_SERVICE_DEBUG=true

# Django Backend Integration
EA_SERVICE_DJANGO_BACKEND_URL=http://127.0.0.1:8000
EA_SERVICE_DJANGO_API_BASE=http://127.0.0.1:8000/api

# JWT Configuration (should match Django SECRET_KEY)
EA_SERVICE_JWT_SECRET_KEY=your-django-secret-key-here
EA_SERVICE_JWT_ALGORITHM=HS256

# EA Management
EA_SERVICE_ALGORITHMS_DIR=../ALGORITHMSMT5EA
EA_SERVICE_MAX_CONCURRENT_EAS=10
EA_SERVICE_EA_TIMEOUT_SECONDS=30

# Process Management
EA_SERVICE_PROCESS_CHECK_INTERVAL=5
EA_SERVICE_CLEANUP_INTERVAL=60

# WebSocket Configuration
EA_SERVICE_WEBSOCKET_PING_INTERVAL=30
EA_SERVICE_WEBSOCKET_PING_TIMEOUT=10

# Logging
EA_SERVICE_LOG_LEVEL=INFO
EA_SERVICE_LOG_FILE=ea_service.log
